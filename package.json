{
  "name": "fuse",
  "private": true,
  "version": "0.2.2",
  "description": "Fuse — a daily chain-reaction puzzle. Same board, same five pieces, one spark.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@fuse/game",
    "build": "npm run build --workspace=@fuse/game",
    "preview": "npm run preview --workspace=@fuse/game",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:parity": "vitest run --project parity",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "grade": "tsx --tsconfig tsconfig.json scripts/grade-boards.ts",
    "seeds": "tsx --tsconfig tsconfig.json scripts/build-seeds.ts",
    "fingerprint": "tsx --tsconfig tsconfig.json scripts/checksum-baseline.ts",
    "android:sync": "npm run build --workspace=@fuse/game && cd apps/game && npx cap sync android && cd ../.. && node scripts/harden-android.mjs",
    "pars": "tsx --tsconfig tsconfig.json scripts/build-pars.ts",
    "show": "tsx --tsconfig tsconfig.json scripts/show-board.ts",
    "verify:seeds": "tsx --tsconfig tsconfig.json scripts/verify-all-seeds.ts",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "csp:check": "node scripts/csp-check.mjs",
    "android:harden": "node scripts/harden-android.mjs",
    "simulate": "tsx --tsconfig tsconfig.json scripts/simulate-players.ts",
    "api:dev": "cd apps/api && npx wrangler dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.124.0"
  }
}
