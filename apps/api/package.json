  },
  "dependencies": {
    "@fuse/gen": "*",
    "@fuse/sim": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "wrangler": "^3.99.0"
  }
}
